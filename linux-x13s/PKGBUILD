# AArch64 multi-platform
# Maintainer: Alex Robinson <alex@ironrobin.net>

buildarch=8
_branch=lenovo-x13s-linux-7.0.y

pkgbase=linux-x13s
_srcname=linux-7.0
_kernelname=${pkgbase#linux}
_desc="ThinkPad X13s (Snapdragon 8cx Gen 3)"
pkgver="7.0.14"
pkgrel=1

arch=('aarch64' 'x86_64')
url="http://www.kernel.org/"
license=('GPL2')
makedepends=('xmlto' 'docbook-xsl' 'kmod' 'inetutils' 'bc' 'git' 'uboot-tools' 'dtc')
options=('!strip')
source=('config'
  'kernel.keyblock'
  'kernel_data_key.vbprivk'
  'linux.preset'
  '60-linux.hook'
  '90-linux.hook'
  'mkinitcpio.conf.d-x13s.conf'
)

# Use dummy md5sum for the local source directory
md5sums=('c970dd3ff3c03087b1b4d6f444f7f8b6'
  '61c5ff73c136ed07a7aadbf58db3d96a'
  '584777ae88bce2c5659960151b64c7d8'
  '593dacde485356f1ba746658d70b82d9'
  '0a5f16bfec6ad982a2f6782724cca8ba'
  '6f99095fbe9f577233b53a83802aab59'
  '2300ce332b36a73e9ab097888d53c98a')

# Determine architecture and cross-compiler
case "$CARCH" in
aarch64)
  _arch=arm64
  _cross=$([[ $(uname -m) == aarch64 ]] && echo "" || echo "aarch64-linux-gnu-")
  ;;
x86_64)
  _arch=x86_64
  _cross=""
  ;;
esac

prepare() {
  if [ ! -d "$_srcname" ]; then
    echo "Shallow cloning steev's linux repo"
    git clone --depth=1 https://github.com/steev/linux.git "$_srcname" -b "$_branch"
  fi

  cd "$_srcname"

  export ARCH="$_arch"
  export CROSS_COMPILE="$_cross"

  echo "Setting version..."
  echo "-$pkgrel" >localversion.10-pkgrel.new
  if ! cmp -s localversion.10-pkgrel.new localversion.10-pkgrel; then
    mv localversion.10-pkgrel.new localversion.10-pkgrel
  else
    rm localversion.10-pkgrel.new
  fi

  echo "${pkgbase#linux}" >localversion.20-pkgname.new
  if ! cmp -s localversion.20-pkgname.new localversion.20-pkgname; then
    mv localversion.20-pkgname.new localversion.20-pkgname
  else
    rm localversion.20-pkgname.new
  fi

  # Only update .config if necessary to avoid unnecessary rebuilds
  if ! cmp -s "${srcdir}/config" .config; then
    cp "${srcdir}/config" .config
    make olddefconfig
  fi
}

build() {
  cd "$_srcname"

  export ARCH="$_arch"
  export CROSS_COMPILE="$_cross"

  # get kernel version
  make prepare
  make -s kernelrelease >version

  # build!
  unset LDFLAGS
  make ${MAKEFLAGS} Image Image.gz modules
  # Generate ONLY the specific X13s device tree blob to avoid build failures in other DTBs
  make ${MAKEFLAGS} qcom/sc8280xp-lenovo-thinkpad-x13s.dtb
}

package_linux-x13s() {
  pkgdesc="The Linux Kernel and modules - ${_desc}"
  depends=(
    coreutils
    kmod
    mkinitcpio
  )
  optdepends=(
    'crda: to set the correct wireless channels of your country'
    'linux-firmware: firmware images needed for some devices'
    'linux-firmware-qcom: firmware images suggested for qcom devices'
  )
  provides=("linux=${pkgver}" "WIREGUARD-MODULE")
  replaces=('linux-armv8')
  conflicts=('linux')
  backup=("etc/mkinitcpio.d/${pkgbase}.preset")
  install=${pkgbase}.install

  cd "$_srcname"
  export ARCH="$_arch"
  export CROSS_COMPILE="$_cross"
  local kernver="$(<version)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  echo "Installing boot image (compressed) and dtbs..."
  install -Dm644 arch/arm64/boot/Image.gz -T "${pkgdir}/boot/vmlinuz-linux"
  install -Dm644 arch/arm64/boot/Image -T "${pkgdir}/boot/vmlinux"
  install -Dm644 arch/arm64/boot/dts/qcom/sc8280xp-lenovo-thinkpad-x13s.dtb -t "${pkgdir}/boot"

  echo "Installing modules..."
  make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 DEPMOD=/doesnt/exist modules_install

  # remove build and source links
  rm -f "$modulesdir"/{build,source}

  # sed expression for following substitutions
  local _subst="
    s|%PKGBASE%|${pkgbase}|g
    s|%KERNVER%|${kernver}|g
  "

  # install mkinitcpio preset file
  sed "${_subst}" ../linux.preset |
    install -Dm644 /dev/stdin "${pkgdir}/etc/mkinitcpio.d/${pkgbase}.preset"

  # install mkinitcpio.conf.d-x13s.conf
  sed "${_subst}" ../mkinitcpio.conf.d-x13s.conf |
    install -Dm644 /dev/stdin "${pkgdir}/etc/mkinitcpio.conf.d/x13s.conf"

  # install pacman hooks
  sed "${_subst}" ../60-linux.hook |
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/libalpm/hooks/60-${pkgbase}.hook"
  sed "${_subst}" ../90-linux.hook |
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/libalpm/hooks/90-${pkgbase}.hook"
}

package_linux-x13s-headers() {
  pkgdesc="Header files and scripts for building modules for linux kernel - ${_desc}"
  provides=("linux-x13s-headers=${pkgver}")
  conflicts=('linux-x13s-headers')

  cd "$_srcname"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  echo "Installing build files..."
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux Kbuild
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/arm64" -m644 arch/arm64/Makefile

  # If cross-compiling, we need to build the scripts for the target architecture
  # so they are included in the package as working binaries.
  if [[ "$_cross" != "" ]]; then
    echo "Building scripts for target architecture..."
    make HOSTCC="${_cross}gcc" ARCH="$_arch" CROSS_COMPILE="$_cross" scripts
  fi

  cp -t "$builddir" -a scripts

  # add xfs and shmem for aufs building
  mkdir -p "$builddir"/{fs/xfs,mm}

  echo "Installing headers..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/arm64" -a arch/arm64/include
  install -Dt "$builddir/arch/arm64/kernel" -m644 arch/arm64/kernel/asm-offsets.s
  mkdir -p "$builddir/arch/arm"
  cp -t "$builddir/arch/arm" -a arch/arm/include

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

  # https://bugs.archlinux.org/task/13146
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h

  # https://bugs.archlinux.org/task/20402
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h

  # https://bugs.archlinux.org/task/71392
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  echo "Installing KConfig, Kbuild and Makefiles..."
  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;
  find . -name 'Kbuild*' -exec install -Dm644 {} "$builddir/{}" \;
  find . -name 'Makefile*' -exec install -Dm644 {} "$builddir/{}" \;

  echo "Removing unneeded architectures..."
  local arch
  for arch in "$builddir"/arch/*/; do
    [[ $arch = */arm64/ || $arch == */arm/ ]] && continue
    echo "Removing $(basename "$arch")"
    rm -r "$arch"
  done

  echo "Removing documentation..."
  rm -r "$builddir/Documentation"

  echo "Cleaning up build artifacts..."
  find "$builddir" -type f -name "*.o" -delete
  find "$builddir" -type f -name "*.ko" -delete
  find "$builddir" -type f -name "*.a" -delete
  find "$builddir" -type f -name "*.mod" -delete
  find "$builddir" -type f -name "*.mod.c" -delete
  find "$builddir" -type f -name "*.cmd" -delete

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

pkgname=("linux-x13s" "linux-x13s-headers")
